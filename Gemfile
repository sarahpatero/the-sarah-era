source "https://rubygems.org"

# Matches the Jekyll version GitHub Pages actually builds with.
gem "github-pages", group: :jekyll_plugins

# Libraries newer Ruby versions no longer bundle; needed only for local preview.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
gem "webrick"

# Windows has no system timezone database.
gem "tzinfo-data", platforms: [:windows, :jruby]
